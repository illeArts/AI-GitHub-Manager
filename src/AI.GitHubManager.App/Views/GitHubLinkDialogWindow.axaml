<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.GitHubManager.App.Views.GitHubLinkDialogWindow"
        Width="480" MinWidth="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock x:Name="HintText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

    <TextBox x:Name="UrlBox" Watermark="https://github.com/owner/repo" />

    <TextBlock x:Name="ErrorText" Foreground="#ff6b6b" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
      <Button Grid.Column="1" x:Name="CancelButton" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" />
      <Button Grid.Column="2" x:Name="SaveButton" Click="OnSave" />
    </Grid>
  </StackPanel>
</Window>
