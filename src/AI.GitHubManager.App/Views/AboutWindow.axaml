<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.GitHubManager.App.Views.AboutWindow"
        Width="460" Height="900"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- Outer shadow wrapper -->
  <Border Margin="8" CornerRadius="14"
          Background="#0d1320"
          BoxShadow="0 8 40 8 #A0000000">

    <Grid RowDefinitions="44,*">

      <!-- Custom title bar -->
      <Grid ColumnDefinitions="*,Auto" Margin="18,0"
            PointerPressed="OnTitleBarPressed">
        <TextBlock x:Name="TitleBarText" VerticalAlignment="Center"
                   Foreground="#6677aa" FontSize="13" />
        <Button Grid.Column="1"
                Content="✕"
                Background="Transparent"
                Foreground="#6677aa"
                BorderThickness="0"
                Padding="8,4"
                FontSize="14"
                VerticalAlignment="Center"
                Click="OnClose"
                Cursor="Hand" />
      </Grid>

      <!-- Content -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                  Margin="32,0,32,28">

        <!-- Circular profile photo -->
        <Border CornerRadius="64" Width="128" Height="128"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                Margin="0,0,0,18"
                BorderBrush="#1e2d45" BorderThickness="3">
          <Image Source="avares://AI.GitHubManager.App/Assets/profile.jpg"
                 Stretch="UniformToFill" />
        </Border>

        <!-- Name -->
        <TextBlock Text="André Iljaschow"
                   FontSize="22" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center" />

        <!-- Subtitle -->
        <TextBlock Text="illeArts  ·  AI Developer"
                   FontSize="13" Foreground="#5566aa"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,18" />

        <!-- Divider -->
        <Rectangle Height="1" Fill="#1a2540" Margin="0,0,0,14" />

        <!-- Tags row -->
        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,14">
          <TextBlock Text="GitHub  ·  git  ·  gh CLI  ·  Avalonia  ·  .NET 8"
                     Foreground="#4dabf7" FontSize="13"
                     VerticalAlignment="Center" />
        </WrapPanel>

        <!-- Description -->
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="#4a5a7a" FontSize="12"
                   LineHeight="19"
                   Margin="0,0,0,18" />

        <!-- Divider -->
        <Rectangle Height="1" Fill="#1a2540" Margin="0,0,0,20" />

        <!-- Logo centered above version -->
        <Image Source="avares://AI.GitHubManager.App/Assets/logo.png"
               Width="130"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Margin="0,0,0,12" />

        <!-- Version -->
        <TextBlock x:Name="VersionText"
                   FontSize="12" Foreground="#5a6b90"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14" />

        <!-- Divider -->
        <Rectangle Height="1" Fill="#1a2540" Margin="0,0,0,14" />

        <!-- Build metadata grid -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              Margin="0,0,0,14">
          <Grid.Styles>
            <Style Selector="TextBlock.metaLabel">
              <Setter Property="Foreground" Value="#5a6b90" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Margin" Value="0,0,10,6" />
            </Style>
            <Style Selector="TextBlock.metaValue">
              <Setter Property="Foreground" Value="#c8d2e8" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
          </Grid.Styles>

          <TextBlock x:Name="BuildLabel"  Grid.Row="0" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="BuildValue"  Grid.Row="0" Grid.Column="1" Classes="metaValue" />

          <TextBlock x:Name="CommitLabel" Grid.Row="1" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="CommitValue" Grid.Row="1" Grid.Column="1" Classes="metaValue" FontFamily="monospace" />

          <TextBlock x:Name="OsLabel"     Grid.Row="2" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="OsValue"     Grid.Row="2" Grid.Column="1" Classes="metaValue" />

          <TextBlock x:Name="ArchLabel"   Grid.Row="3" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="ArchValue"   Grid.Row="3" Grid.Column="1" Classes="metaValue" />

          <TextBlock x:Name="DotnetLabel" Grid.Row="4" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="DotnetValue" Grid.Row="4" Grid.Column="1" Classes="metaValue" />

          <TextBlock x:Name="LicenseLabel" Grid.Row="5" Grid.Column="0" Classes="metaLabel" />
          <TextBlock x:Name="LicenseValue" Grid.Row="5" Grid.Column="1" Classes="metaValue" />
        </Grid>

        <!-- Divider -->
        <Rectangle Height="1" Fill="#1a2540" Margin="0,0,0,14" />

        <!-- GitHub link -->
        <Button x:Name="GitHubLinkButton"
                Click="OnGitHubLinkClick"
                Background="Transparent"
                Foreground="#4dabf7"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Cursor="Hand"
                Margin="0,0,0,14" />

        <!-- Privacy notice -->
        <TextBlock x:Name="PrivacyText" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="#4a5a7a" FontSize="11"
                   LineHeight="16"
                   Margin="0,0,0,10" />

        <!-- Not a GitHub/Microsoft product -->
        <TextBlock x:Name="NotGitHubProductText" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="#3a4a6a" FontSize="11" FontStyle="Italic"
                   Margin="0,0,0,10" />

        <!-- Copyright -->
        <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="#3a4a6a" FontSize="11"
                   Margin="0,0,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
