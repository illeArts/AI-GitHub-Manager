<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.GitHubManager.App.Views.ConfirmYesNoWindow"
        Width="480" MinWidth="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Opacity="0.85" />

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
      <Button Grid.Column="1" x:Name="NoButton" IsCancel="True" Click="OnNo" Margin="0,0,8,0" />
      <Button Grid.Column="2" x:Name="YesButton" Click="OnYes" />
    </Grid>
  </StackPanel>
</Window>
