<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AI.GitHubManager.App.Views.HelpWindow"
        Width="620" Height="620"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="avares://AI.GitHubManager.App/Assets/logo.png">

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Background="#20242b" Padding="20,14" Margin="0,0,0,0">
      <StackPanel>
        <TextBlock x:Name="TitleText"
                   FontSize="20" FontWeight="Bold" Foreground="White" />
        <TextBlock x:Name="SubtitleText"
                   Foreground="#8899aa" FontSize="13" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <!-- Scrollable content -->
    <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
      <StackPanel Spacing="0">

        <!-- ── Quick Start ─────────────────────────────── -->
        <TextBlock x:Name="QsHeader"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#4dabf7" Margin="0,0,0,10" />

        <Border Background="#181c24" CornerRadius="10" Padding="16" Margin="0,0,0,20">
          <StackPanel Spacing="8">
            <TextBlock x:Name="Qs1" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="Qs2" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="Qs3" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="Qs4" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="Qs5" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ── Git basics for beginners ───────────────── -->
        <TextBlock x:Name="BasicsHeader"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#4dabf7" Margin="0,0,0,10" />

        <Border Background="#181c24" CornerRadius="10" Padding="16" Margin="0,0,0,20">
          <StackPanel Spacing="12">
            <TextBlock x:Name="BasicsIntro" Foreground="#c8d0e0" FontSize="13" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" x:Name="BasicsCommitLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BasicsCommit" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Grid.Row="1" Grid.Column="0" x:Name="BasicsPushLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BasicsPush" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Grid.Row="2" Grid.Column="0" x:Name="BasicsPullLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BasicsPull" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Grid.Row="3" Grid.Column="0" x:Name="BasicsFetchLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BasicsFetch" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Grid.Row="4" Grid.Column="0" x:Name="BasicsBranchLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BasicsBranch" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

              <TextBlock Grid.Row="5" Grid.Column="0" x:Name="BasicsConflictLabel" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BasicsConflict" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Commands ───────────────────────────────── -->
        <TextBlock x:Name="CmdHeader"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#4dabf7" Margin="0,0,0,10" />

        <Border Background="#181c24" CornerRadius="10" Padding="16" Margin="0,0,0,20">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="150,*">
              <TextBlock Grid.Column="0" Text="Status" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdStatus" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock Grid.Column="0" Text="Pull" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdPull" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock Grid.Column="0" Text="Commit + Push" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdCommit" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdImportLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdImport" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdEnvLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdEnv" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdScopeLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdScope" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdGitLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdGit" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdRepairTokenLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdRepairToken" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdSanitizeRemoteLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdSanitizeRemote" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdDiagnosticsLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdDiagnostics" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdExportProjectLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdExportProject" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdBuildTestPushLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdBuildTestPush" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdCreateInstallerLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdCreateInstaller" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdInstallInnoSetupLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdInstallInnoSetup" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*">
              <TextBlock x:Name="CmdRemoveOrphanedGitLockLabel" Grid.Column="0" Foreground="#74c0fc" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="CmdRemoveOrphanedGitLock" Grid.Column="1" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Troubleshooting ────────────────────────── -->
        <TextBlock x:Name="TsHeader"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#4dabf7" Margin="0,0,0,10" />

        <Border Background="#181c24" CornerRadius="10" Padding="16" Margin="0,0,0,20">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts1" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts2" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts3" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts4" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts5" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="Ts6" Grid.Column="0" Foreground="#aabbcc" FontSize="13" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ── Security note ─────────────────────────── -->
        <Border Background="#12202e" BorderBrush="#1e3a5f" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,24">
          <StackPanel Spacing="10">

            <!-- Header row with icon -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🔒" FontSize="15" VerticalAlignment="Center" />
              <TextBlock x:Name="SecHeader"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="#74c0fc" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Checklist items -->
            <Grid ColumnDefinitions="22,*">
              <TextBlock Grid.Column="0" Text="✓" Foreground="#51cf66" FontSize="13" />
              <TextBlock x:Name="SecLine1" Grid.Column="1"
                         Foreground="#c8d8ec" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="22,*">
              <TextBlock Grid.Column="0" Text="✓" Foreground="#51cf66" FontSize="13" />
              <TextBlock x:Name="SecLine2" Grid.Column="1"
                         Foreground="#c8d8ec" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="22,*">
              <TextBlock Grid.Column="0" Text="✓" Foreground="#51cf66" FontSize="13" />
              <TextBlock x:Name="SecLine3" Grid.Column="1"
                         Foreground="#c8d8ec" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="22,*">
              <TextBlock Grid.Column="0" Text="✓" Foreground="#51cf66" FontSize="13" />
              <TextBlock x:Name="SecLine4" Grid.Column="1"
                         Foreground="#c8d8ec" FontSize="13" TextWrapping="Wrap" />
            </Grid>

          </StackPanel>
        </Border>

        <!-- ── Version reference ─────────────────────── -->
        <TextBlock x:Name="VersionReferenceText"
                   Foreground="#445566" FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
