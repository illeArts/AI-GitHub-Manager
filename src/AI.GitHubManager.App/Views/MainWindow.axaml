<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AI.GitHubManager.App.Converters"
        x:Class="AI.GitHubManager.App.Views.MainWindow"
        Title="AI GitHub Manager"
        Width="1360"
        Height="720"
        MinWidth="1020"
        MinHeight="560"
        Icon="avares://AI.GitHubManager.App/Assets/logo.png">

  <DockPanel>

    <!-- ── Menu bar ──────────────────────────────────────────────────── -->
    <Menu x:Name="MainMenuBar" DockPanel.Dock="Top" Background="#181c24" Padding="4,2">
      <MenuItem x:Name="MenuSettings"
                Header="{Binding Strings.MenuSettingsHeader}"
                Click="OnSettingsClick"
                Foreground="#d0d6e0" />
      <MenuItem x:Name="MenuHelp"
                Header="{Binding Strings.MenuHelpHeader}"
                Foreground="#d0d6e0">
        <MenuItem x:Name="MenuHelpItem"
                  Header="{Binding Strings.MenuHelpItemHeader}"
                  Click="OnHelpClick" />
        <Separator />
        <MenuItem x:Name="MenuAbout"
                  Header="{Binding Strings.MenuAboutHeader}"
                  Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- ── Update banner (hidden when no update available) ─────────────── -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasUpdateNotice}"
            Background="#1a3a1a" BorderBrush="#2d6a2d" BorderThickness="0,0,0,1"
            Padding="16,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding UpdateNotice}"
                   Foreground="#7ec87e" FontSize="13" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="{Binding Strings.DownloadUpdateBtn}"
                Command="{Binding OpenUpdateCommand}"
                Background="#2d6a2d" Foreground="White"
                Padding="12,4" CornerRadius="6" />
      </Grid>
    </Border>

    <!-- ── Main grid ─────────────────────────────────────────────────── -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*,240" Margin="16">

      <!-- Header -->
      <Border Grid.ColumnSpan="3" Padding="16" CornerRadius="14"
              Background="#20242b" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="AI GitHub Manager"
                     FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="{Binding Strings.AppSubtitle}"
                     Foreground="#d0d6e0" />
        </StackPanel>
      </Border>

      <!-- Left panel: project list only, so it actually gets room to breathe -->
      <Border Grid.Row="1" Grid.Column="0"
              Padding="12" CornerRadius="12"
              BorderBrush="#3b4250" BorderThickness="1"
              Margin="0,0,12,0">
        <DockPanel LastChildFill="True">

          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding Strings.ProjectsHeader}"
                     FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

          <!-- Add / Remove row -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,10">
            <Button Grid.Column="0"
                    Content="{Binding Strings.AddProject}"
                    Command="{Binding AddProjectCommand}"
                    Margin="0,0,4,0" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1"
                    Content="{Binding Strings.RemoveProject}"
                    Command="{Binding RemoveProjectCommand}"
                    Margin="4,0,0,0" HorizontalAlignment="Stretch" />
          </Grid>

          <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <TextBlock Text="{Binding Name}"  FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Owner}" FontSize="12" Opacity="0.7" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Right panel -->
      <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*">

        <!-- Path + actions -->
        <Border Padding="12" CornerRadius="12"
                BorderBrush="#3b4250" BorderThickness="1" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding Strings.LocalLinkHeader}"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- LocalPath row with folder picker button -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBox Grid.Column="0"
                       Watermark="{Binding Strings.PathWatermark}"
                       Text="{Binding LocalPath}" />
              <Button Grid.Column="1"
                      Content="{Binding Strings.PickFolder}"
                      Command="{Binding PickFolderCommand}"
                      Margin="8,0,0,0" />
            </Grid>

            <TextBox Watermark="{Binding Strings.CommitWatermark}"
                     Text="{Binding CommitMessage}" Margin="0,0,0,8" />

            <WrapPanel>
              <Button Content="{Binding Strings.StatusBtn}"
                      Command="{Binding GitStatusCommand}"   Margin="0,0,8,0" />
              <Button Content="{Binding Strings.PullBtn}"
                      Command="{Binding PullCommand}"        Margin="0,0,8,0" />
              <Button Content="{Binding Strings.CommitPushBtn}"
                      Command="{Binding CommitPushCommand}"  Margin="0,0,8,0" />
              <Button Content="{Binding Strings.ExportProjectBtn}"
                      Click="OnExportProjectClick" />
            </WrapPanel>

            <!-- ── Understandable Git operation model (Teil B1–B5) ──────────
                 Complements, never replaces, the buttons above: Status/
                 Aktualisieren/Commit+Push above stay exactly as they were.
                 This panel additionally explains what "Aktualisieren" etc.
                 mean, and offers the remaining normal operations that don't
                 have a dedicated button yet. -->
            <Rectangle Height="1" Fill="#2a3040" Margin="0,14,0,14" />

            <TextBlock Text="{Binding Strings.OperationSectionHeader}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#8899aa" Margin="0,0,0,8" />

            <TextBlock Text="{Binding Strings.OperationDropdownLabel}"
                       FontSize="12" Foreground="#6b7688" Margin="0,0,0,4" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding AvailableOperations}"
                        SelectedItem="{Binding SelectedOperation}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static conv:GitOperationTitleConverter.Instance}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1"
                      Content="{Binding Strings.OperationRunButton}"
                      Command="{Binding ExecuteSelectedOperationCommand}"
                      Margin="8,0,0,0" />
            </Grid>

            <!-- Explanation panel directly under the selection (Teil B4) -->
            <Border Background="#12151c" CornerRadius="8" Padding="12" Margin="0,0,0,10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedOperationTitle}"
                           FontWeight="SemiBold" FontSize="14" Foreground="White" />
                <TextBlock Text="{Binding SelectedOperationDescription}"
                           FontSize="12" Foreground="#c8d0e0" TextWrapping="Wrap" Margin="0,0,0,6" />

                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationSuitableForLabel}" Foreground="#74c0fc" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationSuitableFor}" Foreground="#aabbcc" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationWhatChangesLabel}" Foreground="#74c0fc" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationWhatChanges}" Foreground="#aabbcc" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationWhatStaysLabel}" Foreground="#74c0fc" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationWhatStays}" Foreground="#aabbcc" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationRiskLabel}" Foreground="#74c0fc" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationRisk}" Foreground="#aabbcc" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationRiskLevelLabel}" Foreground="#74c0fc" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationRiskLevelText}" Foreground="#ffd43b" FontWeight="SemiBold" FontSize="12" />
                </Grid>
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Strings.OperationCommandLabel}" Foreground="#5a6b90" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedOperationCommand}" Foreground="#5a6b90" FontFamily="monospace" FontSize="11" />
                </Grid>

                <!-- "Was passiert jetzt?" preview (Teil B6) — only rendered when a
                     canned preview exists for the selected operation (Status,
                     Aktualisieren, Commit erstellen und hochladen in this milestone). -->
                <StackPanel IsVisible="{Binding HasSelectedOperationPreflightPreview}" Margin="0,8,0,0" Spacing="2">
                  <TextBlock Text="{Binding Strings.OperationPreflightStepsLabel}"
                             Foreground="#74c0fc" FontSize="12" Margin="0,0,0,2" />
                  <ItemsControl ItemsSource="{Binding SelectedOperationPreflightSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#aabbcc" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding SelectedOperationPreflightSummary}"
                             Foreground="#8899aa" FontSize="11" FontStyle="Italic"
                             TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ── Advanced commands (Teil B2) — collapsed, informational only,
                 never auto-selected, never executed from here. ─────────────── -->
            <Expander Header="{Binding Strings.AdvancedOperationsExpand}" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <TextBlock Text="{Binding Strings.AdvancedOperationsIntro}"
                           FontSize="11" Foreground="#8899aa" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding AdvancedOperations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#1a1216" BorderBrush="#4a2020" BorderThickness="1"
                              CornerRadius="6" Padding="10" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Converter={x:Static conv:GitOperationTitleWithRiskConverter.Instance}}"
                                     FontWeight="SemiBold" FontSize="12" Foreground="#ff8787" />
                          <TextBlock Text="{Binding Converter={x:Static conv:GitOperationDescriptionConverter.Instance}}" FontSize="11" Foreground="#aa8888" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding TechnicalCommand}" FontFamily="monospace" FontSize="10" Foreground="#665050" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- Info banner -->
        <Border Grid.Row="1" Padding="12,10" CornerRadius="10"
                Background="#181c24" BorderBrush="#2a3a50" BorderThickness="1"
                Margin="0,0,0,12">
          <Grid ColumnDefinitions="22,*">
            <TextBlock Grid.Column="0" Text="🔒"
                       FontSize="13" VerticalAlignment="Top"
                       Margin="0,1,0,0" Opacity="0.6" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Strings.InfoBanner}"
                       TextWrapping="Wrap"
                       Foreground="#6a7f9a" FontSize="12"
                       LineHeight="18" />
          </Grid>
        </Border>

        <!-- Log output -->
        <Border Grid.Row="2" Padding="12" CornerRadius="12"
                BorderBrush="#3b4250" BorderThickness="1">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Strings.OutputHeader}"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBox Text="{Binding Log}"
                     AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Menlo, monospace" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- Actions panel: all task buttons live here, to the right of the output,
           so the project list on the left keeps its own space. -->
      <Border Grid.Row="1" Grid.Column="2"
              Padding="12" CornerRadius="12"
              BorderBrush="#3b4250" BorderThickness="1"
              Margin="12,0,0,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding Strings.ActionsHeader}"
                     FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

          <ScrollViewer>
            <StackPanel>
              <Button Content="{Binding Strings.ImportGitHub}"
                      Command="{Binding ImportGitHubReposCommand}"    Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.InstallCli}"
                      Command="{Binding InstallGitHubCliCommand}"     Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.GitHubLogin}"
                      Command="{Binding LoginGitHubCommand}"          Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.CheckEnv}"
                      Command="{Binding CheckEnvironmentCommand}"     Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.RefreshScope}"
                      Command="{Binding RefreshWorkflowScopeCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.RepairGit}"
                      Command="{Binding SetupGitCommand}"             Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Command="{Binding RepairEnvironmentTokenCommand}"
                      IsVisible="{Binding CanRepairEnvironmentToken}"
                      Background="#5a3a1a" Foreground="White"
                      HorizontalContentAlignment="Center"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding Strings.RepairEnvironmentToken}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </Button>
              <Button Command="{Binding SanitizeRemoteCommand}"
                      IsVisible="{Binding CanSanitizeRemote}"
                      Background="#5a3a1a" Foreground="White"
                      HorizontalContentAlignment="Center"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding Strings.SanitizeRemote}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </Button>
              <Button Command="{Binding RemoveOrphanedGitLockCommand}"
                      IsVisible="{Binding CanRemoveOrphanedGitLock}"
                      Background="#5a3a1a" Foreground="White"
                      HorizontalContentAlignment="Center"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding Strings.RemoveOrphanedGitLockBtn}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </Button>
              <Button Content="{Binding Strings.ExportDiagnostics}"
                      Command="{Binding ExportDiagnosticsCommand}"    Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.SaveProject}"
                      Command="{Binding SaveProjectCommand}"          Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Separator Margin="0,4,0,4" />
              <Button Content="{Binding Strings.BuildTestPushBtn}"
                      Command="{Binding BuildTestPushCommand}"        Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.CreateInstallerBtn}"
                      Command="{Binding CreateInstallerCommand}"      Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Button Content="{Binding Strings.InstallInnoSetupBtn}"
                      Command="{Binding InstallInnoSetupCommand}"
                      IsVisible="{Binding ShowInstallInnoSetup}"      Margin="0,0,0,8" HorizontalAlignment="Stretch" />
              <Separator Margin="0,4,0,4" />
              <Button Content="{Binding Strings.CheckForUpdate}"
                      Command="{Binding CheckForUpdateCommand}"       HorizontalAlignment="Stretch" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
