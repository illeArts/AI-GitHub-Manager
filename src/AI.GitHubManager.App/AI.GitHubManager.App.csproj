<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AI.GitHubManager.App</AssemblyName>
    <RootNamespace>AI.GitHubManager.App</RootNamespace>
    <Version>1.6.3</Version>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
    <FileVersion>1.6.3.0</FileVersion>
    <InformationalVersion>1.6.3</InformationalVersion>
  </PropertyGroup>

  <!-- Windows: suppress console window, add manifest, COM support, and .ico -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- macOS / Linux: standard executable -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- macOS app bundle metadata (used by Avalonia's macOS publish pipeline) -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <CFBundleName>AI GitHub Manager</CFBundleName>
    <CFBundleDisplayName>AI GitHub Manager</CFBundleDisplayName>
    <CFBundleIdentifier>com.illearts.AIGitHubManager</CFBundleIdentifier>
    <CFBundleVersion>1.6.3</CFBundleVersion>
    <CFBundleShortVersionString>1.6.3</CFBundleShortVersionString>
    <NSHumanReadableCopyright>© 2026 illeArts</NSHumanReadableCopyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"              Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"      Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter"  Version="11.2.3" />
    <!-- Required for real macOS integration: bridges Avalonia's NativeMenu
         to the actual NSApplication menu bar (About/Settings/Quit/Help),
         the Dock icon, and the real running-app name shown at the top of
         the screen. Without this package, Avalonia falls back to a
         generic, unbranded default (shows "Avalonia Application" with no
         custom menu items at all) — this was the root cause of Settings/
         Help/About/language being completely unreachable on macOS. -->
    <PackageReference Include="Avalonia.Native"       Version="11.2.3" />
  </ItemGroup>

  <!-- Embed Assets as Avalonia resources (logo, profile picture, icon).
       AppIcon.icns is excluded: it is packaging-only input for the macOS
       .app bundle (Contents/Resources/AppIcon.icns), not an app resource. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\AppIcon.icns" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.GitHubManager.Core\AI.GitHubManager.Core.csproj" />
    <ProjectReference Include="..\AI.GitHubManager.Data\AI.GitHubManager.Data.csproj" />
  </ItemGroup>

  <!-- Allows the test project to use the internal GitService-injecting constructor
       on MainWindowViewModel (test/DI seam for deterministic lock-detection tests). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AI.GitHubManager.Tests" />
  </ItemGroup>

  <!-- Embed the short git commit hash as assembly metadata for the About dialog
       (Teil A3). Falls back to "unknown" when building from a source archive
       without a .git directory, or when git isn't on PATH — never fails the build. -->
  <Target Name="EmbedGitCommitHash" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHashRaw" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitHashExitCode" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHashExitCode)' == '0' AND '$(GitCommitHashRaw)' != ''">$(GitCommitHashRaw)</GitCommitHash>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommitHash</_Parameter1>
        <_Parameter2>$(GitCommitHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
